# Public build-time configuration; these values are embedded in the browser bundle.
# Never put a secret here: the web client is a public OIDC client using PKCE.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1
NEXT_PUBLIC_OIDC_ISSUER=http://127.0.0.1:18080/realms/nextstep
NEXT_PUBLIC_OIDC_CLIENT_ID=nextstep-web
